{
  "format_review": 1,
  "id": "fixture-flow",
  "enabled": false,
  "parameters": {
    "base_url": "http://127.0.0.1:8781"
  },
  "http_profiles": {
    "app": {
      "User-Agent": "StreamLab/1"
    }
  },
  "flows": {
    "catalogue": {
      "output": "events.items",
      "steps": [
        {
          "id": "catalogue",
          "op": "http.json",
          "version": 1,
          "url": "{parameters.base_url}/catalogue.json",
          "http_profile": "app"
        },
        {
          "id": "events",
          "op": "items.map",
          "version": 1,
          "input": "catalogue.document",
          "items_pointer": "",
          "fields": {
            "id": "/id",
            "title": "/title"
          }
        }
      ]
    },
    "sources": {
      "output": "signals.items",
      "steps": [
        {
          "id": "detail",
          "op": "http.json",
          "version": 1,
          "url": "{parameters.base_url}/events/{input.item.id}.json",
          "path_encoding": "component_once",
          "http_profile": "app"
        },
        {
          "id": "signals",
          "op": "items.map",
          "version": 1,
          "input": "detail.document",
          "items_pointer": "/signals",
          "fields": {
            "id": "/id",
            "label": "/label",
            "play_type": "/play_type",
            "url": "/url"
          }
        }
      ]
    },
    "resolve": {
      "output": "stream.result",
      "steps": [
        {
          "id": "stream",
          "op": "resolver.dispatch",
          "version": 1,
          "input": "input.candidate",
          "resolver_set": "fixture_players"
        }
      ]
    }
  },
  "resolver_sets": {
    "fixture_players": {
      "on_unknown": "unsupported_host",
      "routes": [
        {
          "when": {
            "play_type": "m3u8"
          },
          "use": "direct-hls@1"
        },
        {
          "when": {
            "play_type": "iframe",
            "host": "127.0.0.1"
          },
          "use": "synthetic-envelope@1"
        }
      ]
    }
  }
}
