{
  "schema_version": 1,
  "id": "adapter-demo",
  "name": "Synthetic binary adapter contract",
  "enabled": false,
  "catalogue": {
    "kind": "adapter",
    "adapter": {
      "id": "synthetic-catalogue",
      "version": 1
    }
  },
  "resolution": {
    "kind": "adapter",
    "adapter": {
      "id": "synthetic-session",
      "version": 1
    }
  },
  "http": {
    "timeout_seconds": 15,
    "max_redirects": 3,
    "headers_by_role": {
      "catalogue": {
        "User-Agent": "Mozilla/5.0"
      },
      "resolver": {
        "User-Agent": "Mozilla/5.0"
      }
    },
    "cookie_scope": "per_source_and_domain",
    "cross_origin_credentials": "never_automatic"
  },
  "lifecycle": {
    "resolve_on_play": true,
    "expiry": "unknown",
    "max_network_retries": 2,
    "respect_retry_after": true,
    "max_refresh_attempts": 0
  },
  "playback": {
    "allowed_formats": [
      "hls"
    ],
    "detect_from_body": true,
    "require_device_capability_check": true
  }
}
