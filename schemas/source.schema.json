{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structure of a Mana source file (TOML, or JSON with the same data). The contract and the rules beyond structure (references, kinds, names, cycles) are in docs/configuration.md and crates/core/src/source/; the Rust validation is what the app applies.",
  "title": "Mana source",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "catalogue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "title"
                ],
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/flow"
        }
      ]
    },
    "sources": {
      "$ref": "#/$defs/flow"
    },
    "resolve": {
      "oneOf": [
        {
          "$ref": "#/$defs/flow"
        },
        {
          "type": "object",
          "properties": {
            "routes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/route"
              }
            }
          },
          "required": [
            "routes"
          ],
          "additionalProperties": false
        }
      ]
    },
    "resolvers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/flow"
      }
    },
    "recipes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "steps": {
            "$ref": "#/$defs/steps"
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "resolve"
  ],
  "additionalProperties": false,
  "$defs": {
    "template": {
      "type": "string",
      "$comment": "Text with references: {step.field.0}, {input.candidate.url}, {pool.{order.0}}, {config.\"a:b\"}, {x|component}."
    },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/template"
      }
    },
    "headers": {
      "anyOf": [
        {
          "type": "string",
          "$comment": "A header set of the source"
        },
        {
          "$ref": "#/$defs/templates"
        }
      ]
    },
    "step_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": {
        "enum": [
          "input",
          "item"
        ]
      }
    },
    "flow": {
      "type": "object",
      "properties": {
        "steps": {
          "$ref": "#/$defs/steps"
        }
      },
      "required": [
        "steps"
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "http"
            },
            "url": {
              "$ref": "#/$defs/template"
            },
            "method": {
              "enum": [
                "GET",
                "POST"
              ]
            },
            "query": {
              "$ref": "#/$defs/templates"
            },
            "body": {
              "$ref": "#/$defs/template"
            },
            "headers": {
              "$ref": "#/$defs/headers"
            }
          },
          "required": [
            "id",
            "op",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "json"
            },
            "from": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "id",
            "op",
            "from"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "m3u"
            },
            "from": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "id",
            "op",
            "from"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "html.attr"
            },
            "from": {
              "$ref": "#/$defs/template"
            },
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "attribute": {
              "type": "string",
              "minLength": 1
            },
            "base": {
              "$ref": "#/$defs/template"
            },
            "all": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "op",
            "from",
            "selector",
            "attribute"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "nextflight"
            },
            "from": {
              "$ref": "#/$defs/template"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "op",
            "from",
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "protobuf"
            },
            "from": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "id",
            "op",
            "from"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "text.match"
            },
            "from": {
              "$ref": "#/$defs/template"
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "op",
            "from",
            "pattern"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "list.map"
            },
            "list": {
              "$ref": "#/$defs/template"
            },
            "item": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/template"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "from": {
                        "$ref": "#/$defs/template"
                      },
                      "pattern": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "from",
                      "pattern"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "from": {
                        "$ref": "#/$defs/template"
                      },
                      "format": {
                        "type": "string",
                        "minLength": 1
                      },
                      "zone": {
                        "type": "string",
                        "pattern": "^(Z|[+-][0-9]{2}:[0-9]{2})$"
                      }
                    },
                    "required": [
                      "from",
                      "format"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "where": {
              "$ref": "#/$defs/templates"
            },
            "call": {
              "type": "string",
              "minLength": 1
            },
            "input": {
              "$ref": "#/$defs/templates"
            },
            "present": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "op",
            "list"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "item"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "call"
                    ]
                  },
                  {
                    "required": [
                      "input"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "call"
              ],
              "not": {
                "required": [
                  "item"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "text"
            },
            "template": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "id",
            "op",
            "template"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "url.param"
            },
            "from": {
              "$ref": "#/$defs/template"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "op",
            "from",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "url.query_after"
            },
            "from": {
              "$ref": "#/$defs/template"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "op",
            "from",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "url.set"
            },
            "from": {
              "$ref": "#/$defs/template"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "id",
            "op",
            "from",
            "name",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "base64.decode"
            },
            "from": {
              "$ref": "#/$defs/template"
            },
            "alphabet": {
              "enum": [
                "standard",
                "url"
              ]
            }
          },
          "required": [
            "id",
            "op",
            "from"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "base64.encode"
            },
            "from": {
              "$ref": "#/$defs/template"
            },
            "alphabet": {
              "enum": [
                "standard",
                "url"
              ]
            },
            "padding": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "op",
            "from"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "hex.decode"
            },
            "from": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "id",
            "op",
            "from"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "hex.encode"
            },
            "from": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "id",
            "op",
            "from"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "rot47"
            },
            "from": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "id",
            "op",
            "from"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "bytes.xor"
            },
            "a": {
              "$ref": "#/$defs/template"
            },
            "b": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "id",
            "op",
            "a",
            "b"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "md5"
            },
            "from": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "id",
            "op",
            "from"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "aes.decrypt"
            },
            "mode": {
              "enum": [
                "gcm",
                "ctr",
                "cbc"
              ]
            },
            "key": {
              "$ref": "#/$defs/template"
            },
            "iv": {
              "$ref": "#/$defs/template"
            },
            "data": {
              "$ref": "#/$defs/template"
            },
            "aad": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "id",
            "op",
            "mode",
            "key",
            "iv",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "aes.encrypt"
            },
            "mode": {
              "enum": [
                "ctr"
              ]
            },
            "key": {
              "$ref": "#/$defs/template"
            },
            "iv": {
              "$ref": "#/$defs/template"
            },
            "data": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "id",
            "op",
            "mode",
            "key",
            "iv",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "call"
            },
            "recipe": {
              "type": "string",
              "minLength": 1
            },
            "input": {
              "$ref": "#/$defs/templates"
            }
          },
          "required": [
            "id",
            "op",
            "recipe"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "stream"
            },
            "url": {
              "$ref": "#/$defs/template"
            },
            "headers": {
              "$ref": "#/$defs/headers"
            },
            "format": {
              "enum": [
                "hls",
                "dash",
                "progressive"
              ]
            },
            "expires_at": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "id",
            "op",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "next"
            },
            "candidate": {
              "allOf": [
                {
                  "$ref": "#/$defs/templates"
                },
                {
                  "required": [
                    "id",
                    "url"
                  ]
                }
              ]
            }
          },
          "required": [
            "id",
            "op",
            "candidate"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/step_id"
            },
            "op": {
              "const": "date"
            },
            "from": {
              "$ref": "#/$defs/template"
            },
            "format": {
              "type": "string",
              "minLength": 1
            },
            "zone": {
              "type": "string",
              "pattern": "^(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "required": [
            "id",
            "op",
            "from",
            "format"
          ],
          "additionalProperties": false
        }
      ]
    },
    "route": {
      "type": "object",
      "properties": {
        "when": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "use": {
          "type": "string",
          "minLength": 1
        },
