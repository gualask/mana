{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Design draft only. No Mana runtime currently consumes this schema. Structural validation does not establish source or device compatibility.",
  "title": "Mana source profile — draft 1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "catalogue": {
      "$ref": "#/$defs/catalogue"
    },
    "resolution": {
      "$ref": "#/$defs/resolution"
    },
    "http": {
      "$ref": "#/$defs/http"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "playback": {
      "$ref": "#/$defs/playback"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "enabled",
    "catalogue",
    "resolution",
    "http",
    "lifecycle",
    "playback"
  ],
  "additionalProperties": false,
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "query": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "url",
        "method"
      ],
      "additionalProperties": false
    },
    "fields": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "title": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "home": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "away": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "competition": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "starts_at": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "url": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "language": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "catalogue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "direct"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "url"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "entries"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "m3u"
            },
            "request": {
              "$ref": "#/$defs/request"
            }
          },
          "required": [
            "kind",
            "request"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "json"
            },
            "request": {
              "$ref": "#/$defs/request"
            },
            "items_pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            },
            "fields": {
              "$ref": "#/$defs/fields"
            }
          },
          "required": [
            "kind",
            "request",
            "items_pointer",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "embedded_json"
            },
            "request": {
              "$ref": "#/$defs/request"
            },
            "serialization": {
              "const": "next_flight"
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "required_row_keys": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "fields": {
              "$ref": "#/$defs/fields"
            }
          },
          "required": [
            "kind",
            "request",
            "serialization",
            "field",
            "required_row_keys",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "html"
            },
            "request": {
              "$ref": "#/$defs/request"
            },
            "item_selector": {
              "type": "string",
              "minLength": 1
            },
            "fields": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "request",
            "item_selector",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "adapter"
            },
            "adapter": {
              "$ref": "#/$defs/adapter"
            }
          },
          "required": [
            "kind",
            "adapter"
          ],
          "additionalProperties": false
        }
      ]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "iframe"
            },
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "multiple": {
              "const": "require_selection"
            }
          },
          "required": [
            "kind",
            "selector",
            "multiple"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "json_api"
            },
            "request": {
              "$ref": "#/$defs/request"
            },
            "items_pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            },
            "url_pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            },
            "id_pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            }
          },
          "required": [
            "kind",
            "request",
            "items_pointer",
            "url_pointer",
            "id_pointer"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "adapter"
            },
            "adapter": {
              "$ref": "#/$defs/adapter"
            }
          },
          "required": [
            "kind",
            "adapter"
          ],
          "additionalProperties": false
        }
      ]
    },
    "resolution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "direct"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "host_dispatch"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "hosts": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
                    },
                    "minItems": 1
                  },
                  "operation": {
                    "$ref": "#/$defs/operation"
                  }
                },
                "required": [
                  "hosts",
                  "operation"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "max_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "on_unknown": {
              "const": "unsupported_host"
            }
          },
          "required": [
            "kind",
            "rules",
            "max_depth",
            "on_unknown"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "adapter"
            },
            "adapter": {
              "$ref": "#/$defs/adapter"
            }
          },
          "required": [
            "kind",
            "adapter"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unverified"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "http": {
      "type": "object",
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "max_redirects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "headers_by_role": {
          "type": "object",
          "properties": {
            "catalogue": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z0-9-]+$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[^\\r\\n]*$"
              }
            },
            "resolver": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z0-9-]+$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[^\\r\\n]*$"
              }
            },
            "manifest": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z0-9-]+$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[^\\r\\n]*$"
              }
            },
            "segment": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z0-9-]+$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[^\\r\\n]*$"
              }
            },
            "key": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z0-9-]+$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[^\\r\\n]*$"
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "cookie_scope": {
          "const": "per_source_and_domain"
        },
        "cross_origin_credentials": {
          "const": "never_automatic"
        }
      },
      "required": [
        "timeout_seconds",
        "max_redirects",
        "headers_by_role",
        "cookie_scope",
        "cross_origin_credentials"
      ],
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "resolve_on_play": {
          "const": true
        },
        "expiry": {
          "enum": [
            "provider",
            "unknown",
            "not_applicable"
          ]
        },
        "max_network_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "respect_retry_after": {
          "const": true
        },
        "max_refresh_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "refresh_adapter": {
          "$ref": "#/$defs/adapter"
        }
      },
      "required": [
        "resolve_on_play",
        "expiry",
        "max_network_retries",
        "respect_retry_after",
        "max_refresh_attempts"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "max_refresh_attempts": {
                "const": 1
              }
            }
          },
          "then": {
            "required": [
              "refresh_adapter"
            ]
          }
        }
      ]
    },
    "playback": {
      "type": "object",
      "properties": {
        "allowed_formats": {
          "type": "array",
          "items": {
            "enum": [
              "hls",
              "dash",
              "progressive"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "detect_from_body": {
          "const": true
        },
        "require_device_capability_check": {
          "const": true
        }
      },
      "required": [
        "allowed_formats",
        "detect_from_body",
        "require_device_capability_check"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "resolution": {
            "properties": {
              "kind": {
                "const": "unverified"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "enabled": {
            "const": false
          }
        }
      }
    }
  ]
}
